#!/usr/bin/env bash
# Install Antigen and write ~/.config/zsh/antigen.zsh, wired into ~/.zshrc.
set -euo pipefail
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "==> install-antigen: installing Antigen"
if [[ ! -f "$HOME/antigen.zsh" ]]; then
  curl -L git.io/antigen > "$HOME/antigen.zsh"
fi

echo "==> install-antigen: writing ~/.config/zsh/antigen.zsh"
mkdir -p "$HOME/.config/zsh"
if [[ -f "$HOME/.config/zsh/antigen.zsh" ]]; then
  cp "$HOME/.config/zsh/antigen.zsh" "$HOME/.config/zsh/antigen.zsh.bak"
fi
cp "$REPO_DIR/config/zsh/antigen.zsh" "$HOME/.config/zsh/antigen.zsh"

# Wire a marked block into ~/.zshrc (idempotent: replaces any previous block).
ZSHRC="$HOME/.zshrc"
BEGIN="# >>> rift-wm-installer antigen >>>"
END="# <<< rift-wm-installer antigen <<<"

if [[ -f "$ZSHRC" ]]; then
  sed -i '' "/^${BEGIN}$/,/^${END}$/d" "$ZSHRC"
fi

{
  echo "$BEGIN"
  echo 'if [[ -f "$HOME/antigen.zsh" ]] && [[ -f "$HOME/.config/zsh/antigen.zsh" ]]; then'
  echo '  source "$HOME/antigen.zsh"'
  echo '  source "$HOME/.config/zsh/antigen.zsh"'
  echo 'fi'
  echo "$END"
} >> "$ZSHRC"

echo "    added marked antigen block to $ZSHRC"
